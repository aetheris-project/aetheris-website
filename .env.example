# Aetheris Website - environment reference
# Copy to .env.local for local development. Production values are managed in
# the Vercel dashboard for the aetheris-website project.

# Public site configuration (baked at build time; see lib/config/whitelabel.ts
# for the full schema and lib/config/whitelabel.json for the source of truth).
NEXT_PUBLIC_SITE_URL=https://aetheris.enterprise

# Optional: remote whitelabel configuration endpoint. When set, the
# WhitelabelProvider fetches this JSON on the client and merges it over the
# static default. Leave empty to use the checked-in whitelabel.json.
NEXT_PUBLIC_WHITELABEL_URL=

# Optional: Redis-backed dynamic config (used by the app repo). The website
# falls back to the static JSON when unset.
AETHERIS_REDIS_URL=
